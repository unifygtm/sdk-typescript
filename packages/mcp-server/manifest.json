{
  "dxt_version": "0.1",
  "name": "unify-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Unify API",
  "author": {
    "name": "Unify",
    "email": "support@unifygtm.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-sdks/unify-typescript.git"
  },
  "homepage": "https://github.com/stainless-sdks/unify-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://www.unifygtm.com/support",
  "server": {
    "type": "node",
    "entry_point": "${__dirname}/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "UNIFY_API_KEY": "${user_config.UNIFY_API_KEY}"
      }
    }
  },
  "user_config": {
    "UNIFY_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
